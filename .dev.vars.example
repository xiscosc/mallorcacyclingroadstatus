# Local overrides for wrangler dev. Copy to `.dev.vars` (gitignored) and fill in.
# Consell de Mallorca ArcGIS REST layers (`f=json`): the `incidencies` point layer
# (metadata) and the `trams` polyline layer (geometry), joined by `idlocalit`.
CONSELL_POINTS_URL=
CONSELL_LINES_URL=
# Cloudflare Turnstile keys. Use the always-passing test pair locally:
#   https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Strava OAuth app credentials. Create one at https://www.strava.com/settings/api
# Set the "Authorization Callback Domain" to `localhost` for dev,
# `mallorcacyclingroads.cc` for prod.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
